<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.10" />
    <!-- GĐ5 Đ-5.16: test hub đi ĐÚNG đường client thật (WebSockets + SkipNegotiation). Ghim 8.0.x cùng lineage net8. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <!-- Đọc được cả YAML (file hợp đồng) lẫn JSON (Swagger runtime) về CÙNG một OpenApiDocument nên
         so sánh hai bên không phải tự viết parser. Ghim 1.6.14 = đúng version Swashbuckle 6.6.2 đang
         kéo về, tránh downgrade conflict. -->
    <PackageReference Include="Microsoft.OpenApi.Readers" Version="1.6.14" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.0.0" />
    <!-- Cùng version Testcontainers.PostgreSql: hai bản lõi Testcontainers khác nhau là NU1605 downgrade. -->
    <PackageReference Include="Testcontainers.Redis" Version="4.0.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\backend\SocialApp.Api\SocialApp.Api.csproj" />
  </ItemGroup>

  <!-- File hợp đồng của từng module, link vào thư mục output của TEST (không phải của Api) để so
       với Swagger runtime. Cố ý không khai <Content> trong csproj của module: làm vậy thì file sẽ
       chảy theo build sang output của Api và bị publish vào image — hợp đồng không có việc gì trong
       image chạy production. Thêm một dòng ở đây cho mỗi module từ GĐ2. -->
  <ItemGroup>
    <Content Include="..\..\src\backend\Modules\Identity\Presentation\identity-v1.yaml"
             Link="Contracts\identity-v1.yaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\backend\Modules\Identity\Presentation\admin-v1.yaml"
             Link="Contracts\admin-v1.yaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\backend\Modules\Profile\Presentation\profile-v1.yaml"
             Link="Contracts\profile-v1.yaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\backend\Modules\Content\Presentation\content-v1.yaml"
             Link="Contracts\content-v1.yaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\backend\Modules\SocialGraph\Presentation\socialgraph-v1.yaml"
             Link="Contracts\socialgraph-v1.yaml"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- GĐ5 (Mục 10.5 #1, #2): hợp đồng REST của Messaging + ví dụ payload của hub. Thiếu dòng thì test không tìm thấy file. -->
    <Content Include="..\..\src\backend\Modules\Messaging\Presentation\messaging-v1.yaml"
             Link="Contracts\messaging-v1.yaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\backend\Modules\Messaging\Presentation\chat-hub-v1.examples.json"
             Link="Contracts\chat-hub-v1.examples.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\backend\Modules\Moderation\Presentation\moderation-v1.yaml"
             Link="Contracts\moderation-v1.yaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\backend\Modules\Notification\Presentation\notification-v1.yaml"
             Link="Contracts\notification-v1.yaml"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
