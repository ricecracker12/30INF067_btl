# Khóa cho backup.sh — chép thành deploy/backup.env TRÊN VM (gitignore), KHÔNG commit giá trị thật.
# Tách khỏi .env vì: (1) .env có giá trị chứa ';' mà bash không source được; (2) đây là token R2 riêng
# cho bucket backup, phạm vi tối thiểu, không dùng chung với R2__* của ứng dụng (Đ-7.10).
# docker run --env-file đọc file này: giá trị viết TRẦN, không ngoặc kép.

# rclone remote tên "r2" — cấu hình qua biến môi trường, không cần rclone.conf
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACL=private

# Bucket RIÊNG cho backup (không phải socialapp-dev / socialapp-staging) + tiền tố theo môi trường
BACKUP_R2_BUCKET=socialmedia-backup
BACKUP_PREFIX=staging

# Monitor loại Push trong Uptime Kuma (B1): chỉ phần TRƯỚC dấu '?' của URL Kuma đưa.
# backup.sh gọi nó khi full backup xong; Kuma không thấy push trong 26 giờ → cảnh báo "backup không chạy".
BACKUP_KUMA_PUSH_URL=http://127.0.0.1:3002/api/push/<token>
