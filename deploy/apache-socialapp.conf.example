# VirtualHost gộp Frontend + Backend cùng domain mxh.banhgao.net (định tuyến theo path).
#   /api, /swagger, /health  -> Backend ASP.NET (container 127.0.0.1:18080)
#   /  (mọi path còn lại)     -> Frontend Next.js (container 127.0.0.1:3000)  [F1 — BẮT BUỘC bật]
# Cài đặt:
#   sudo a2enmod proxy proxy_http ssl headers
#   sudo cp apache-socialapp.conf.example /etc/apache2/sites-available/socialapp.conf
#   sudo a2ensite socialapp && sudo apache2ctl configtest && sudo systemctl reload apache2
#
# ⚠️ Thứ tự ProxyPass: /api, /swagger, /health TRƯỚC catch-all /. Đảo ngược → mọi API thành HTML Next.

<VirtualHost *:80>
    ServerName mxh.banhgao.net
    Redirect permanent / https://mxh.banhgao.net/
</VirtualHost>

<VirtualHost *:443>
    ServerName mxh.banhgao.net

    SSLEngine on
    SSLCertificateFile    /etc/ssl/cloudflare/banhgao.net.pem
    SSLCertificateKeyFile /etc/ssl/cloudflare/banhgao.net.key

    ProxyPreserveHost On
    RequestHeader set X-Forwarded-Proto "https"

    # --- GĐ7 D1: HSTS cho MỌI đường (giai-doan-7.md Đ-7.12). Frontend đã tự gửi (src/frontend/next.config.ts)
    #     nhưng /api, /health, /swagger thì không. unset header của backend TRƯỚC rồi mới set — thiếu dòng unset
    #     thì trang frontend nhận HAI header HSTS (một của Next, một của apache). Cần mod headers (a2enmod ở trên).
    Header onsuccess unset Strict-Transport-Security
    Header always set Strict-Transport-Security "max-age=31536000"

    # --- GĐ7 D2: chặn hai endpoint demo lỗi của GĐ0 từ Internet (Đ-7.13) — /ping/boom cho bất kỳ ai tự tạo lỗi 500.
    #     Không sửa code: integration test vẫn dùng chúng; C5 vẫn bắn được từ VM qua 127.0.0.1:18080 (không qua apache).
    #     KHÔNG viết <Location /api/v1/ping> — chặn luôn /api/v1/ping, monitor "api ping" của Kuma đỏ theo.
    <LocationMatch "^/api/v1/ping/(boom|app-error)$">
        Require all denied
    </LocationMatch>

    # --- Backend API (ASP.NET Core) — liệt kê TRƯỚC để ưu tiên hơn catch-all "/" ---
    ProxyPass        /api     http://127.0.0.1:18080/api
    ProxyPassReverse /api     http://127.0.0.1:18080/api
    ProxyPass        /swagger http://127.0.0.1:18080/swagger
    ProxyPassReverse /swagger http://127.0.0.1:18080/swagger
    ProxyPass        /health  http://127.0.0.1:18080/health
    ProxyPassReverse /health  http://127.0.0.1:18080/health

    # --- Frontend (Next.js standalone + BFF) — F1 ---
    ProxyPass        /  http://127.0.0.1:3000/
    ProxyPassReverse /  http://127.0.0.1:3000/

    # Realtime SignalR (GĐ5): cần "sudo a2enmod proxy_wstunnel" và thêm, đặt TRƯỚC dòng /api:
    #   ProxyPass /hubs ws://127.0.0.1:18080/hubs

    ErrorLog  ${APACHE_LOG_DIR}/socialapp-error.log
    CustomLog ${APACHE_LOG_DIR}/socialapp-access.log combined
</VirtualHost>
