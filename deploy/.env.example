POSTGRES_PASSWORD=
ConnectionStrings__Postgres=Host=postgres;Database=socialapp;Username=socialapp;Password=
ConnectionStrings__Redis=redis:6379
Redis__ConnectionString=redis:6379

Jwt__SigningKey=
Jwt__Issuer=
Jwt__Audience=socialapp-api
# TTL access token, tính bằng giây
Jwt__AccessTokenSeconds=900
# Tuổi thọ refresh token (ngày) — phải khớp Max-Age của cookie refresh (Mục 8: 604800s = 7 ngày).
Jwt__RefreshTokenDays=7

Cors__AllowedOrigins__0=
Cors__AllowedOrigins__1=http://localhost:3000

# Dùng cho CẢ HAI phía: API ký URL, và frontend dựng CSP cho R2 (Đ-E17 — container frontend đọc qua
# env_file). Dạng scheme://host, KHÔNG kèm tên bucket, KHÔNG dấu / ở cuối. Thiếu nó thì Next từ chối
# phục vụ ngoài Development, vì mọi lượt tải ảnh lên sẽ bị trình duyệt chặn.
R2__Endpoint=
R2__Bucket=
R2__AccessKey=
R2__SecretKey=

Smtp__Host=smtp.resend.com
Smtp__Port=587
# Đúng chữ "resend", không phải địa chỉ email.
Smtp__User=resend
# API key (re_…) — chỉ trên server, không commit.
Smtp__Password=
# Phải thuộc domain đã Verified trên Resend.
Smtp__From=

Frontend__BaseUrl=

API_INTERNAL_URL=
REDIS_URL=
APP_ORIGIN=

SESSION_ENCRYPTION_KEY=

TRUSTED_PROXY_HOPS=1

ReverseProxy__TrustedNetworks__0=
