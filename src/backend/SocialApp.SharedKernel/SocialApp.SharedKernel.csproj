<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- SharedKernel chứa middleware (RFC7807, correlation ID, rate limit) nên cần kiểu ASP.NET Core -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.1.0" />
    <!-- Thu hồi access token (D8, Đ-D8): bên đọc ở host, bên ghi ở Identity (GĐ1) và Moderation (GĐ6) → chỗ chung duy nhất
         là SharedKernel. Api nhận lại qua project reference. -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="UUIDNext" Version="4.2.4" />
    <!-- Đ-2.14 (chốt 2026-09-18): dependency bên thứ ba thứ ba của SharedKernel. R2 tương thích S3 một cách cố ý; không có
         gói Cloudflare.R2 cho .NET. KHÔNG có traffic nào đi qua AWS (endpoint là https://<account-id>.r2.cloudflarestorage.com),
         không cần tài khoản AWS. Chỉ presign + HEAD + Delete + List — KHÔNG TransferUtility. Ghim chính xác version. -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.3" />
    <!-- GĐ7 C2: chỉ số nghiệp vụ (giai-doan-7.md Mục 5.2). Module ghi số qua Observability/BusinessMetrics, không chạm kiểu
         Prometheus. Không dùng System.Diagnostics.Metrics: đã thử 4 cách, counter không tự xuất ra /metrics (hướng dẫn khối
         C, Mục 2). Cùng version với prometheus-net.AspNetCore của Api — lệch là hai bản prometheus-net trong một process. -->
    <PackageReference Include="prometheus-net" Version="8.2.1" />
    <!-- GĐ5 C4 (Đ-5.13, ADR-003): backplane Redis cho SignalR khi có bản sao API thứ hai. Ghim 8.0.x cùng lineage net8; chỉ nạp
         vào pipeline khi Realtime:Backplane:Enabled = true. Managed code thuần — chạy được trên ARM64. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="8.0.10" />
  </ItemGroup>

</Project>
