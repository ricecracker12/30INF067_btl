        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "100 * (sum(rate(http_requests_received_total{job=\"socialapp-api\",controller!=\"\",code=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_requests_received_total{job=\"socialapp-api\",controller!=\"\"}[5m])) or vector(0), 1e-9)",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "p95 toàn API (5 phút)",
      "description": "GOAL-01: feed p95 ≤ 500ms. Toàn API, không riêng feed — xem panel theo action bên dưới.",
